# Public repositories do not require GitHub credentials.
#
# Private repository support:
# - Use a fine-grained GitHub personal access token selected only for the
#   private repositories Voyages should read.
# - Minimum repository permissions: Contents = Read-only. GitHub Metadata
#   remains read-only automatically.
# - Never prefix these variables with NEXT_PUBLIC_.
GITHUB_READ_TOKEN=
GITHUB_PRIVATE_REPO_ALLOWLIST=jenozu/yuzimiONLINE

# Required to keep allowlisted private repository contents from being exposed
# through the public Vercel URL. Use a separate random passphrase (24+ chars).
# You enter this Voyages password in the unlock form; it is NOT the GitHub token.
VOYAGES_PRIVATE_ACCESS_SECRET=
